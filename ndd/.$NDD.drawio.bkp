        <mxCell id="sPHG6lRdqJ20UJaOccKs-1" value="&lt;pre style=&quot;margin-top: 0px;&quot;&gt;&lt;font&gt;application pods on the x86 nodes use OVN-Kubernetes as their primary CNI.&lt;br&gt;But — pods dataplane (OVS) is offloaded onto the DPU.&lt;br&gt;&lt;b style=&quot;&quot;&gt;OVN-K&lt;/b&gt; is split into two halves:&lt;br&gt;&amp;nbsp; - host component — runs on the x86 OpenShift nodes&lt;br&gt;&amp;nbsp; - DPU component — runs as a pod on the DPU cluster (ovn-configuration.yaml)&lt;br&gt;&amp;nbsp; Together they are the CNI for host workloads.&lt;/font&gt;&lt;/pre&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="329" y="151" width="489" height="114" as="geometry" />
        </mxCell>
        <mxCell id="sPHG6lRdqJ20UJaOccKs-2" value="&lt;pre style=&quot;margin-top: 0px;&quot;&gt;&lt;font&gt;The &lt;b data-path-to-node=&quot;5&quot; data-index-in-node=&quot;4&quot; style=&quot;&quot;&gt;dataplane&lt;/b&gt; (or data path) refers to the processing mechanism &lt;br&gt;that a packet travels to get from point A to point B.&lt;br&gt;includes:&lt;br&gt;&lt;b data-path-to-node=&quot;6,0,0&quot; data-index-in-node=&quot;0&quot; style=&quot;&quot;&gt;Packet Inspection:&lt;/b&gt; Checking headers (MAC, IP, TCP/UDP ports).&lt;br&gt;&lt;b data-path-to-node=&quot;6,1,0&quot; data-index-in-node=&quot;0&quot; style=&quot;&quot;&gt;Encapsulation/Decapsulation:&lt;/b&gt; Wrapping packets in Geneve/VXLAN overlay tunnels &lt;br&gt;&lt;b data-path-to-node=&quot;6,2,0&quot; data-index-in-node=&quot;0&quot; style=&quot;&quot;&gt;Flow Lookup &amp;amp; Actions:&lt;/b&gt; Matching a packet against rules &lt;/font&gt;&lt;/pre&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="595" y="330" width="630" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sPHG6lRdqJ20UJaOccKs-3" value="" style="endArrow=classic;html=1;rounded=0;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
