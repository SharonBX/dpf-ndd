        <mxCell id="ZVNzUyj5W7BXCwKrW6l3-4" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontStyle=0" value="&lt;pre style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;DPU CLUSTER&amp;nbsp; (BlueField-3 Arm cores = worker nodes,&amp;nbsp;&lt;br/&gt;hosted by Hypershift on the host)&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="37" width="364" x="48" y="560" as="geometry" />
        </mxCell>
        <mxCell id="ZVNzUyj5W7BXCwKrW6l3-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 7px;&quot;&gt;ovnkube-node-*&lt;/font&gt;" vertex="1">
