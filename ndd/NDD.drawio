        <mxCell id="ZVNzUyj5W7BXCwKrW6l3-7" parent="ZVNzUyj5W7BXCwKrW6l3-11" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;pre style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;&quot;&gt;dpuCNIBinPath: /var/lib/cni/bin/&amp;nbsp; &amp;nbsp; &amp;nbsp; # CNI binaries live&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;&quot;&gt;dpuCNIPath:&amp;nbsp; &amp;nbsp; /run/multus/cni/net.d/ # CNI config lives&lt;/font&gt;&lt;/font&gt;&lt;/pre&gt;" vertex="1">
