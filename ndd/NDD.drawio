        <mxCell id="ZVNzUyj5W7BXCwKrW6l3-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 8px;&quot;&gt;ovn-kubernetes-resource-injector&lt;/font&gt;" vertex="1">
          <mxGeometry height="20.5" width="124" x="51" y="320" as="geometry" />
        </mxCell>
        <mxCell id="ZVNzUyj5W7BXCwKrW6l3-28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 7px;&quot;&gt;multus&lt;/font&gt;" vertex="1">
          <mxGeometry height="12.5" width="55" x="155" y="353" as="geometry" />
        </mxCell>
        <mxCell id="ZVNzUyj5W7BXCwKrW6l3-29" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Masters&lt;/font&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="37" width="95" x="171" y="265" as="geometry" />
        </mxCell>
        <mxCell id="sPHG6lRdqJ20UJaOccKs-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;pre style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;application pods on the x86 nodes use OVN-Kubernetes as their primary CNI.&lt;br&gt;But — pods dataplane (OVS) is offloaded onto the DPU.&lt;br&gt;&lt;b&gt;OVN-K&lt;/b&gt; is split into two halves:&lt;br&gt;&amp;nbsp; - host component — runs on the x86 OpenShift nodes&lt;br&gt;&amp;nbsp; - DPU component — runs as a pod on the DPU cluster (ovn-configuration.yaml)&lt;br&gt;&amp;nbsp; Together they are the CNI for host workloads.&lt;/font&gt;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="108" width="371" x="348" y="215" as="geometry" />
        </mxCell>
        <mxCell id="sPHG6lRdqJ20UJaOccKs-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;pre style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The &lt;b data-path-to-node=&quot;5&quot; data-index-in-node=&quot;4&quot; style=&quot;&quot;&gt;dataplane&lt;/b&gt; (or data path) refers to the processing mechanism &lt;br&gt;that a packet travels to get from point A to point B.&lt;br&gt;includes:&lt;br/&gt;&lt;b data-path-to-node=&quot;6,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Packet Inspection:&lt;/b&gt; Checking headers (MAC, IP, TCP/UDP ports).&lt;br/&gt;&lt;b data-path-to-node=&quot;6,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Encapsulation/Decapsulation:&lt;/b&gt; Wrapping packets in Geneve/VXLAN overlay tunnels &lt;br/&gt;&lt;b data-path-to-node=&quot;6,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Flow Lookup &amp;amp; Actions:&lt;/b&gt; Matching a packet against rules &lt;/font&gt;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="120" width="371" x="595" y="330" as="geometry" />
        </mxCell>
        <mxCell id="sPHG6lRdqJ20UJaOccKs-3" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
